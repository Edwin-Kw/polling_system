{
  "name": "@polling/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs = require('node:fs'); for (const name of ['schema', 'seed']) fs.copyFileSync('src/db/' + name + '.sql', 'dist/db/' + name + '.sql');\"",
    "test": "vitest run --root ../.. --project api",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@polling/shared": "0.1.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "socket.io-client": "^4.8.1"
  }
}
